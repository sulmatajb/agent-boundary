include README.md LICENSE THIRD_PARTY_NOTICES.md SECURITY.md CONTRIBUTING.md CHANGELOG.md AGENTS.md
include Dockerfile compose.yaml .dockerignore .gitignore
recursive-include docs *.md
recursive-include evidence *.json
recursive-include security *.json *.md LICENSE.* NOTICE.*
recursive-include scripts *.py
recursive-include examples *.py
recursive-include tests *.py
recursive-include .github *.md *.yml
prune work
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store
